# Postgres connection string. Locally: your own Postgres. On Vercel: the Neon
# integration sets DATABASE_URL (or POSTGRES_URL) for you.
DATABASE_URL=postgresql://user:password@localhost:5432/between

# Optional. Without it the app still works; AI briefs fall back to the
# rule-based summary and SOAP/DAP drafting is disabled.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-7

# Optional. Extra origins allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:5173

# Create tables and load the demo caseload when the database is empty.
# AUTO_SEED=true
